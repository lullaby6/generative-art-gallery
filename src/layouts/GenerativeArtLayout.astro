---
import Layout from "@/layouts/Layout.astro";

export interface Props {
	title?: string;
}

const { title = "Generative Art Gallery" } = Astro.props;
---

<Layout title={title}>
	<a
		id="btn-back"
		href="/"
		class="absolute top-0 left-0 m-8 text-2xl cursor-pointer bg-white rounded-full px-4 pb-1 opacity-50 hover:opacity-100 transition-opacity">
		←
	</a>

	<main id="main">
		<slot />
	</main>
</Layout>
